# Copy to `.env` and fill in, or export these in your shell.
# Credentials are read from the environment only. Never put a key in config/.

# --- Generator (default family: anthropic) ---------------------------------
ANTHROPIC_API_KEY=

# --- Judge (default family: openai) ----------------------------------------
# The judge MUST be a different model family from the generator. Self-preference
# bias is real: a judge favours phrasing that sounds like itself, which is the
# exact AI tell criterion C4 exists to catch. The engine refuses to run both on
# one family unless providers.allow_same_family is set deliberately, and stamps
# any such run judge_independence: DEGRADED.
OPENAI_API_KEY=

# With neither key present the engine runs in MOCK MODE: the full pipeline
# executes — validation, isolation, iteration, rendering, persistence — with
# fixture-composed copy. Every artifact is stamped `mock: true` so it can never
# be mistaken for a real model run.
