alse, "hideShareAction": false, "hideSendAction": false, "hideRepostsCount": false, "hideViewsCount": false, "trustInterventionBanner": null, "hideReactAction": false, "hideCommentAction": false, "shareUrl": "https://www.linkedin.com/posts/manish-jha-999803183_mobilerobots-warehouseautomation-industry40-activity-6790658873150853121-SSmI?", "showContributionExperience": false, "showSocialDetail": true}, "header": {"text": null}, "entityId": "6790658873150853121", "shareUrn": "urn:li:share:6790658872790122496", "shareLinkedinUrl": "https://www.linkedin.com/feed/update/urn:li:share:6790658872790122496", "repost": {"id": "6790628611260002304", "linkedinUrl": "https://www.linkedin.com/posts/addverb_mobilerobots-warehouseautomation-industry40-activity-6790628611260002304-Lrze", "content": "The global autonomous mobile robots market size was valued at USD 1.9 billion in 2020 and is expected to grow at a compound annual growth rate (CAGR)of 19.6% from 2021 to 2027.\n\nAMRs are highly preferred owing to the myriad of benefits, such as preventing product damage, reducing labour costs, enhancing productivity, and automating processes, they can potentially offer. Dynamo, AMR by Addverb can transform your material movement by providing countless benefits to your operations.\n\nClick here to know more about Dynamo: https://lnkd.in/es-vA7Q\nor reach out to us at automate@addverb.com \n\n#mobilerobots #warehouseautomation #industry40 #robotics #logistics", "contentAttributes": [], "author": {"id": "13178640", "universalName": "addverb", "publicIdentifier": null, "type": "company", "name": "Addverb", "linkedinUrl": "https://www.linkedin.com/company/addverb/posts", "info": "117,239 followers", "website": null, "websiteLabel": null, "avatar": {"url": "https://media.licdn.com/dms/image/v2/D560BAQF0Izck_3kkyw/company-logo_400_400/B56Z6nOn44KQAY-/0/1780922090359/addverb_logo?e=1790812800&v=beta&t=ImUs7DPbfNh7A88MC_5mgrO-alrnyrd6tYXrMVqLGrE", "width": 400, "height": 400}, "urn": "13178640", "companyId": "13178640"}, "postedAt": {"timestamp": 1619012024703, "date": "2021-04-21T13:33:44.703Z", "postedAgoShort": "5yr", "postedAgoText": "5 years ago • Visible to anyone on or off LinkedIn"}, "postImages": [{"url": "https://media.licdn.com/dms/image/v2/C4E22AQEODfo1hq2Y4w/feedshare-shrink_1280/feedshare-shrink_1280/0/1619012023924?e=1790812800&v=beta&t=GfOiTcEa2r44XqB8n7A1Zk09XU1qN7DqaPe_uvipfMA", "width": 1280, "height": 1280}], "socialContent": {"hideCommentsCount": false, "hideReactionsCount": false, "hideSocialActivityCounts": false, "hideShareAction": false, "hideSendAction": false, "hideRepostsCount": false, "hideViewsCount": false, "trustInterventionBanner": null, "hideReactAction": false, "hideCommentAction": false, "shareUrl": "https://www.linkedin.com/posts/addverb_mobilerobots-warehouseautomation-industry40-activity-6790628611260002304-Lrze?", "showContributionExperience": false, "showSocialDetail": true}, "comments": [], "header": {"text": null}, "entityId": "6790628611260002304", "shareUrn": "urn:li:share:6790628610534375425", "shareLinkedinUrl": "https://www.linkedin.com/feed/update/urn:li:share:6790628610534375425", "engagement": null}, "engagement": {"id": "6790658873150853121", "likes": 29, "comments": 0, "shares": 0, "reactions": [{"type": "LIKE", "count": 29}]}, "reactionIds": [], "commentIds": [], "query": {"sortBy": "date", "page": "1", "profilePublicIdentifier": "https://www.linkedin.com/in/manish-jha-999803183/", "sessionId": "7435dfb2-e480-44af-9bf1-ceb8262e60b3"}}, {"type": "post", "id": "7476180676027838464", "linkedinUrl": "https://www.linkedin.com/posts/manish-jha-999803183_addverbturns10-10yearsofinnovation-10nnovate-activity-7476180676027838464-pfyB", "content": "10 Years. One Incredible Journey. 🤖✨\n\nA decade ago, Addverb started with a bold belief that humans, robots, and possibilities could coexist to transform the way the world works. Today, standing in our office surrounded by the people who made it happen, I feel nothing but deep gratitude and immense pride.\n\nI've had a front-row seat to some of the most exciting moments in India's robotics story from building our first automation solutions to becoming a globally recognised name in warehouse automation and intelligent robotics.\n\nBut what truly makes Addverb special isn't the technology we've built it's the people we've built it with.\n\nThese photos say it all. The laughter, the camaraderie, the pride in our eyes this is what 10 years of shared vision, late nights, bold bets, and relentless innovation looks like.\n\n💡 To our founders - thank you for dreaming big.\n🤝 To my tribe - thank you for showing up every single day.\n🏆 To our customers and partners - thank you for trusting us.\n\nHere's to the next decade of Human | Robot | Possibilities. 🚀\n\n#AddverbTurns10 #10YearsOfInnovation #10nnovate #Robotics #WarehouseAutomation #Milestone #Leadership #Innovation #TeamAddverb #DecadeOfGrowth", "contentAttributes": [{"start": 52, "length": 7, "type": "COMPANY_NAME", "hyperlink": null, "textLink": null, "company": {"id": "13178640", "name": "Addverb", "linkedinUrl": "https://www.linkedin.com/company/addverb/"}}, {"start": 552, "length": 7, "type": "COMPANY_NAME", "hyperlink": null, "textLink": null, "company": {"id": "13178640", "name": "Addverb", "linkedinUrl": "https://www.linkedin.com/company/addverb/"}}], "author": {"id": "ACoAACteKcUBQUnxs1lulmB0Y5D-U151pfMnyHA", "universalName": null, "publicIdentifier": "manish-jha-999803183", "type": "profile", "name": "Manish Jha", "linkedinUrl": "https://www.linkedin.com/in/manish-jha-999803183?miniProfileUrn=urn%3Ali%3Afsd_profile%3AACoAACteKcUBQUnxs1lulmB0Y5D-U151pfMnyHA", "info": "Chief Information Officer at Addverb", "website": null, "websiteLabel": null, "avatar": {"url": "https://media.licdn.com/dms/image/v2/C4D03AQEo53rhjbApqQ/profile-displayphoto-shrink_800_800/profile-displayphoto-shrink_800_800/0/1597125999683?e=1790812800&v=beta&t=0gUvGzPYMLm1tKAqXwS2nzz81Ixb12bDldFpTvXkDrM"