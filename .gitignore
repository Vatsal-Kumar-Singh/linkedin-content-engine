# Secrets — credentials are read from the environment only.
.env
.env.local

# Virtualenvs and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/

# Regenerable output. Runs and animation frames are reproducible from the specs,
# templates and config that ARE tracked, and they grow without bound.
engine/runs/
engine/outputs/
temp/

# OS noise
Thumbs.db
.DS_Store
desktop.ini

# Generated by scripts/gen_calendar.py. Regenerate rather than committing a snapshot:
# a committed calendar drifts from the registry and the profile it came from.
engine/posts/*/
!engine/posts/example/

# Scraped third-party posts. `research/raw/` holds the full text of other companies'
# LinkedIn posts and `research/batches/` holds reading digests of the same text. This
# repository is public, and redistributing somebody else's content is not ours to do.
# Both are regenerable: research/scrape_sample.py rebuilds raw from the sample frame,
# make_batches.py rebuilds the batches from raw. What IS tracked is the part that is our
# own work and the part that makes the finding checkable: the labels (post id -> label)
# and findings.json, which carries metadata and labels but no post text.
research/raw/
research/batches/
research/raw_people/
