# Secrets — credentials are read from the environment only.
.env
.env.local

# Virtualenvs and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/

# Regenerable output. Runs and animation frames are reproducible from the specs,
# templates and config that ARE tracked, and they grow without bound.
engine/runs/
engine/outputs/
temp/

# OS noise
Thumbs.db
.DS_Store
desktop.ini

# Generated by scripts/gen_calendar.py. Regenerate rather than committing a snapshot:
# a committed calendar drifts from the registry and the profile it came from.
engine/posts/*/
!engine/posts/example/

# Scraped third-party posts ARE tracked, on the repository owner's decision, so the
# corpus is reproducible without re-scraping: `research/raw/` holds the full text of
# 77 company pages and 47 person profiles, and the batch directories hold reading
# digests of the same text. ~24MB.
#
# **This is only appropriate while the repository is private.** It is the full text of
# other companies' LinkedIn posts, and redistributing it publicly is a different act
# from publishing our own analysis of it. If this repository is ever made public, these
# five directories must come out of the history, not just out of the working tree --
# deleting the files in a later commit leaves them in every clone and every fork.
#
# Everything here is regenerable: scrape_sample.py rebuilds raw/ from the sample frame
# (about $2.50 of Apify credit), make_batches.py rebuilds the batches from raw/.
